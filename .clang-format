---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
AccessModifierOffset: -2
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  # Own headers of the file being formatted come first (handled by IncludeIsMainRegex).
  - Regex: '^"facetry/'
    Priority: 2
  - Regex: '^"'
    Priority: 3
  - Regex: '^<[a-z_]+>$'
    Priority: 5
  - Regex: '^<'
    Priority: 4
...
