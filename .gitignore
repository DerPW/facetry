# macOS
.DS_Store

# Xcode / Swift
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
.swiftpm/
.build/

# C++ / CMake
/build/
/out/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json

# Third-party build outputs (OpenCASCADE, PlaneGCS, ...)
/third_party/_build/
/third_party/_install/
/third_party/_dist/

# Web
node_modules/
dist/
.vite/

# Editors
.vscode/
.idea/
*.swp

# Claude Code (local, per-machine settings)
.claude/settings.local.json

# Generated Xcode project (see apps/apple/project.yml)
apps/apple/*.xcodeproj/

# Core WebAssembly module, built by CMake (core/wasm)
apps/web/src/core/wasm/*.mjs
apps/web/src/core/wasm/*.wasm

# Frameworks for the Apple app, built by apps/apple/scripts/build-core.sh
apps/apple/Frameworks/
