# OpenCASCADE build pin. Read by build.sh, package.sh and fetch.sh, and by cmake/FacetryOCCT.cmake.
# Changing any value here requires new prebuilt artifacts (see README.md).

OCCT_VERSION=8.0.1
OCCT_TAG=V8_0_1
OCCT_SHA256=0d6913eae4bcc09a3653ceced6dda1aec11c35a1513d4c06762c9b002092c68a

# Bump when build options or the toolkit list change while OCCT_VERSION stays the same.
OCCT_BUILD_REV=1

# Toolkits to build. Their dependencies are added by OCCT's CMake automatically.
# STEP (TKDESTEP) pulls in TKXCAF, which depends on TKService and TKV3d (no OpenGL).
OCCT_TOOLKITS="TKernel TKMath TKG2d TKG3d TKGeomBase TKBRep TKGeomAlgo TKTopAlgo TKPrim TKBO TKBool TKFillet TKOffset TKFeat TKMesh TKShHealing TKDESTEP TKDESTL"

# Minimum OS versions for the Apple slices (provisional until ADR-0009).
OCCT_APPLE_DEPLOYMENT_TARGET=26.0
