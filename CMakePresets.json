{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "apple-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS (Debug)",
      "inherits": "apple-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS (Release)",
      "inherits": "apple-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device (Release, build only)",
      "inherits": "apple-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS simulator (Debug, build only)",
      "inherits": "apple-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly (Debug)",
      "inherits": "wasm-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly (Release)",
      "inherits": "wasm-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "ios-device", "configurePreset": "ios-device" },
    { "name": "ios-simulator", "configurePreset": "ios-simulator" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" },
    { "name": "wasm-release", "configurePreset": "wasm-release" }
  ],
  "testPresets": [
    { "name": "macos-debug", "configurePreset": "macos-debug", "output": { "outputOnFailure": true } },
    { "name": "macos-release", "configurePreset": "macos-release", "output": { "outputOnFailure": true } },
    { "name": "wasm-debug", "configurePreset": "wasm-debug", "output": { "outputOnFailure": true } },
    { "name": "wasm-release", "configurePreset": "wasm-release", "output": { "outputOnFailure": true } }
  ]
}
